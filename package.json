{
    "name": "japanese-learning-capture",
    "type": "module",
    "version": "2.0.1",
    "packageManager": "pnpm@11.5.2",
    "description": "日语学习资料的刮削、管理工具🤪",
    "author": "yoyokity",
    "main": "./dist/main/index.js",
    "scripts": {
        "type-check": "vue-tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint . --fix && prettier . --write --experimental-cli",
        "start": "chcp 65001 && electron-vite preview --outDir=dist",
        "dev": "chcp 65001 && electron-vite dev --outDir=dist",
        "build": "npm run build:icons && npm run build:vite",
        "build:vite": "electron-vite build --outDir=dist",
        "build:icons": "electron-icon-builder --input=./resources/mainIcon.png --output=./build -f",
        "package": "npm run build && electron-forge package"
    },
    "dependencies": {
        "onnxruntime-node": "^1.29.0",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "@ai-sdk/deepseek": "^3.0.32",
        "@ai-sdk/google": "^4.0.51",
        "@ai-sdk/openai": "^4.0.47",
        "@antfu/eslint-config": "^9.3.0",
        "@cloudimage/before-after": "^1.0.4",
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@electron-toolkit/utils": "^4.0.0",
        "@formatjs/intl-segmenter": "^12.2.13",
        "@primeuix/themes": "^2.0.3",
        "@techstark/opencv-js": "5.0.0-release.1",
        "@trpc/client": "10.45.2",
        "@trpc/server": "10.45.2",
        "@tsconfig/strictest": "^2.0.8",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^24",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.4.0",
        "ai": "^7.0.79",
        "autoprefixer": "^10.5.4",
        "cheerio": "^1.2.0",
        "cssnano": "^8.0.9",
        "dayjs": "^1.11.23",
        "dompurify": "^3.4.14",
        "electron": "43.4.1",
        "electron-icon-builder": "^2.0.1",
        "electron-log": "^5.4.4",
        "electron-store": "^11.0.2",
        "electron-trpc": "^0.7.1",
        "electron-vite": "^5.0.0",
        "es-toolkit": "^1.51.0",
        "eslint": "^10.9.1",
        "eslint-plugin-import-x": "^4.17.1",
        "fs-extra": "^11.4.0",
        "fuzzball": "^2.2.6",
        "github-markdown-css": "^5.9.0",
        "iconv-lite": "^0.7.3",
        "js-opencc": "^1.4.2",
        "lenis": "^1.3.26",
        "marked": "^18.0.11",
        "p-queue": "^9.3.3",
        "pathe": "^2.0.3",
        "pinia": "^4.0.3",
        "pinia-plugin-persistedstate": "^4.7.1",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5",
        "sass": "^1.103.1",
        "superjson": "^2.2.6",
        "terser": "^5.51.0",
        "tinyglobby": "^0.2.17",
        "typescript": "^6.0.3",
        "uuid": "^14.0.2",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vite-svg-loader": "^5.1.2",
        "vue": "^3.5.41",
